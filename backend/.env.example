# === 全局 Gemini API Key ===
GEMINI_API_KEY=your_gemini_api_key_here

# === 後台管理員密鑰 ===
ADMIN_API_KEY=your_admin_secret_key

# === Redis 設定（Docker 環境下 REDIS_HOST 會被 docker-compose 覆蓋為 redis）===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# === PostgreSQL 設定（Docker 環境下 DATABASE_URL 會被 docker-compose 覆蓋）===
POSTGRES_PASSWORD=your_strong_password
DATABASE_URL=postgresql://aigenie:your_strong_password@localhost:5432/aigenie

# === Frappe ERP 連線設定 ===
FRAPPE_URL=https://hr.leopilot.com
FRAPPE_API_KEY=your_frappe_api_key
FRAPPE_API_SECRET=your_frappe_api_secret

# === 各品牌專用 Gemini API Key ===
# 這些是根據 tenants.json 中的 api_key_env 字段自動讀取的
TENANT_SECOND_HAND_CAR_GEMINI_API_KEY=your_api_key
TENANT_LEOSYS_GEMINI_API_KEY=your_api_key
TENANT_LEOSYS_AI_LAB_GEMINI_API_KEY=your_api_key
TENANT_DAWHO_GEMINI_API_KEY=your_api_key
TENANT_EMPEROR_CHEMICAL_CO_LTD_GEMINI_API_KEY=your_api_key
TENANT_CLASSIC_GEMINI_API_KEY=your_api_key
TENANT_CAESARPARK_GEMINI_API_KEY=your_api_key
TENANT_XIYUANTANG_GEMINI_API_KEY=your_api_key
TENANT_TPE_POLICY_GEMINI_API_KEY=your_api_key
TENANT_EVERLIGHT_CHEMICAL_GEMINI_API_KEY=your_api_key
TENANT_TAIWANGLASS_GEMINI_API_KEY=your_api_key
TENANT_ZOHO_GEMINI_API_KEY=your_api_key
TENANT_EOA168_GEMINI_API_KEY=your_api_key
TENANT_SANDAK_GEMINI_API_KEY=your_api_key
TENANT_TEST_GEMINI_API_KEY=your_api_key
TENANT_DEMO_0_GEMINI_API_KEY=your_api_key

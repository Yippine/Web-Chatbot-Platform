# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.amazonq
/.kiro
/public/images/*

# nginx
nginx.conf

# backend runtime data (images only; tenants.json is versioned)
backend/data/images/

# sensitive backup archives
sensitive-backup-*.tar.gz
sensitive-backup-*.zip

# --- BEGIN AI-CORE MANAGED (gitignore-sync) ---
# ============================================================
# AI Core .gitignore 模板
# 維護：.claude/skills/gitignore-sync/references/gitignore.template
# ============================================================

# ── Claude Code：保留設定與技能，忽略執行狀態 ──────────────
.claude/

# ── AI Core：忽略任務執行與對話狀態 ────────────────────────
.ai-core/tasks/
.ai-core/sessions/
.ai-core/chat/

# ── AI Core self/：AI 自我狀態分級版控 ────────────────────
# SOUL.md(憲法級)+RELATIONS.json(慢變·感情成長史) 入版控；
# STATE.json(每 turn settle)+events.jsonl(append-only 高頻留痕) 為 runtime，不入版控。
.ai-core/self/STATE.json
.ai-core/self/events.jsonl
.ai-core/self/decay-report.md
.ai-core/self/DEPTH.json

# ── AI Core Entity Cache ────────────────────────────────────
.ai-core/.cache/
.ai-core/projects/*/.cache/
.ai-core/repos/*/.cache/

# ── Obsidian App Config ─────────────────────────────────────
.obsidian/

# ── Resources：忽略媒體，保留 HTML Canvas ───────────────────
**/resources/*
!**/resources/*.html
# 未來擴增格式加在此處（e.g. !**/resources/*.canvas）

# ── External References（根目錄錨定）───────────────────────
/references/

# ── 圖片 / 影片 ─────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.webm
*.mov

# ── 二進位文件格式 ──────────────────────────────────────────
*.xmind

# ── 暫存檔 ──────────────────────────────────────────────────
tmp/
.tmp_xmind*/

# ── AI Core Secrets（本機環境變數，永不進版控）──────────────
.ai-core/config/.env

# ── docs-archive ImportLog（runtime 狀態，不入版控）─────────
.ai-core/.import-log
# --- END AI-CORE MANAGED ---

CLAUDE.md